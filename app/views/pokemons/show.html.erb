<h1><%= @pokemon.name %></h1>

<% if @pokemon.sprite_url.present? %>
  <%= image_tag @pokemon.sprite_url, alt: @pokemon.name %>
<% else %>
  <p>No image available.</p>
<% end %>

<h2>Pokémon Details</h2>

<p><strong>Pokédex Number:</strong> <%= @pokemon.pokedex_number %></p>
<p><strong>Height:</strong> <%= @pokemon.height %></p>
<p><strong>Weight:</strong> <%= @pokemon.weight %></p>
<p><strong>Base Experience:</strong> <%= @pokemon.base_experience %></p>

<h2>Types</h2>
<ul>
  <% @pokemon.types.each do |type| %>
    <li><%= type.name %></li>
  <% end %>
</ul>

<h2>Abilities</h2>
<ul>
  <% @pokemon.abilities.each do |ability| %>
    <li><%= ability.name %></li>
  <% end %>
</ul>

<h2>Moves</h2>
<ul>
  <% @pokemon.moves.limit(10).each do |move| %>
    <li><%= move.name %></li>
  <% end %>
</ul>

<h2>Trainer Reviews</h2>

<% if @pokemon.reviews.any? %>
  <% @pokemon.reviews.limit(5).each do |review| %>
    <div class="review">
      <h3><%= review.trainer_name %></h3>

      <p>
        <strong>Rating:</strong>
        <%= "⭐" * review.rating %>
      </p>

      <p><%= review.comment %></p>

      <hr>
    </div>
  <% end %>
<% else %>
  <p>No trainer reviews yet.</p>
<% end %>

<p><%= link_to "Back to Pokémon List", pokemons_path %></p>